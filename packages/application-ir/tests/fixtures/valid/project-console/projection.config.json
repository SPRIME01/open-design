{
  "schemaVersion": 1,
  "application": "application.ir.json",
  "targets": [
    {
      "id": "html-static",
      "adapter": "html-static",
      "mode": "scaffold",
      "outputRoot": "generated/html-static",
      "frontend": { "adapter": "html-static" }
    },
    {
      "id": "react-vite",
      "adapter": "react-vite",
      "mode": "scaffold",
      "outputRoot": "generated/react-vite",
      "frontend": { "adapter": "react-vite" }
    },
    {
      "id": "sveltekit",
      "adapter": "sveltekit",
      "mode": "scaffold",
      "outputRoot": "generated/sveltekit",
      "frontend": { "adapter": "sveltekit" }
    },
    {
      "id": "nextjs-app",
      "adapter": "nextjs-app",
      "mode": "scaffold",
      "outputRoot": "generated/nextjs-app",
      "frontend": { "adapter": "nextjs-app" }
    },
    {
      "id": "mock-local",
      "adapter": "mock-local",
      "mode": "scaffold",
      "outputRoot": "generated/mock-local",
      "transport": { "adapter": "mock-local" }
    },
    {
      "id": "next-server-actions",
      "adapter": "next-server-actions",
      "mode": "scaffold",
      "outputRoot": "generated/next-server-actions",
      "transport": { "adapter": "next-server-actions" }
    },
    {
      "id": "sqlite-better-sqlite3",
      "adapter": "sqlite-better-sqlite3",
      "mode": "scaffold",
      "outputRoot": "generated/sqlite-better-sqlite3",
      "persistence": { "adapter": "sqlite-better-sqlite3" }
    }
  ]
}
