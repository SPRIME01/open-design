{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "noEmit": true,
    // Tests import sibling-package src (application-targets adapters), so the
    // no-emit typecheck root must span the workspace packages directory.
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
