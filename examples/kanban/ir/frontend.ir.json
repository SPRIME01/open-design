  "flows": [],
  "localState": [],
  "operationBindings": [
    {
      "node": "component.column-todo",
      "operation": "cards.list"
    },
    {
      "node": "component.column-doing",
      "operation": "cards.list"
    },
    {
      "node": "component.column-done",
      "operation": "cards.list"
    },
    {
      "node": "component.add-card-form",
      "operation": "cards.create"
    },
    {
      "node": "component.card",
      "operation": "cards.move"
    }
  ],
  "tokenReferences": [
    "--bg",
    "--surface",
    "--fg",
    "--muted",
    "--border",
    "--accent"
  ],
  "accessibilityDefaults": {
    "focusVisible": true,
    "reducedMotion": true
  }
