{
  "schemaVersion": "1.0.0",
  "applicationId": "kanban",
  "routes": [
    {
      "id": "route.board",
      "path": "/",
      "screen": "screen.board"
    }
  ],
  "screens": [
    {
      "id": "screen.board",
      "rootNode": "semantic.board"
    }
  ],
  "components": [],
  "nodes": [
    {
      "id": "semantic.board",
      "level": "semantic",
      "kind": "kanban-board",
      "slots": {
        "content": [
          "atomic.board-heading",
          "component.add-card-form",
          "component.column-todo",
          "component.column-doing",
          "component.column-done"
        ]
      },
      "bindings": [],
      "actions": [],
      "states": ["loading", "empty", "ready", "error"],
      "styleIntent": {
        "density": "comfortable",
        "width": "wide"
      },
      "responsive": {
        "phone": "stack",
        "desktop": "grid"
      },
      "accessibility": {
        "landmark": "main",
        "headingLevel": 1
      },
      "sourceRef": "brief.board"
    },
    {
      "id": "atomic.board-heading",
      "level": "atomic",
      "kind": "heading",
      "children": [],
      "bindings": [],
      "actions": [],
      "states": [],
      "styleIntent": {
        "size": "large"
      },
      "responsive": {},
      "accessibility": {
        "label": "Kanban Board",
        "headingLevel": 1
      },
      "sourceRef": "brief.board"
    },
    {
      "id": "component.add-card-form",
      "level": "component",
      "kind": "form",
      "slots": {
        "fields": ["atomic.card-title-input"],
        "actions": ["atomic.add-card-button"]
      },
      "bindings": [],
      "actions": [
        {
          "trigger": "submit",
          "operation": "cards.create",
          "input": {
            "title": "atomic.card-title-input.value"
          }
        }
      ],
      "states": ["idle", "submitting", "success", "validation-error", "service-error"],
      "styleIntent": {
        "surface": "raised"
      },
      "responsive": {},
      "accessibility": {
        "label": "Add a card"
      },
      "sourceRef": "capability.cards.create"
    },
    {
      "id": "atomic.card-title-input",
      "level": "atomic",
      "kind": "input",
      "children": [],
      "bindings": [],
      "actions": [],
      "states": ["empty", "valid", "invalid"],
      "styleIntent": {
        "size": "medium"
      },
      "responsive": {},
      "accessibility": {
        "label": "Card title",
        "required": true
      },
      "sourceRef": "domain.card.title"
    },
    {
      "id": "atomic.add-card-button",
      "level": "atomic",
      "kind": "button",
      "children": [],
      "bindings": [],
      "actions": [
        {
          "trigger": "activate",
          "intent": "submit-nearest-form"
        }
      ],
      "states": ["enabled", "disabled", "pending"],
      "styleIntent": {
        "variant": "primary"
      },
      "responsive": {},
      "accessibility": {
        "label": "Add card"
      },
      "sourceRef": "capability.cards.create"
    },
    {
      "id": "component.column-todo",
      "level": "component",
      "kind": "list",
      "slots": {
        "heading": ["atomic.todo-heading"],
        "items": ["component.card"]
      },
      "bindings": [],
      "actions": [],
      "states": ["loading", "empty", "ready", "error"],
      "styleIntent": {},
      "responsive": {},
      "accessibility": {
        "label": "Todo column"
      },
      "sourceRef": "enum.card-column.todo"
    },
    {
      "id": "atomic.todo-heading",
      "level": "atomic",
      "kind": "heading",
      "children": [],
      "bindings": [],
      "actions": [],
      "states": [],
