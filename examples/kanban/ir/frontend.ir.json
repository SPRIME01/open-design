    {
      "id": "atomic.doing-heading",
      "level": "atomic",
      "kind": "heading",
      "children": [],
      "bindings": [],
      "actions": [],
      "states": [],
      "styleIntent": {
        "size": "medium"
      },
      "responsive": {},
      "accessibility": {
        "label": "Doing",
        "headingLevel": 2
      },
      "sourceRef": "enum.card-column.doing"
