    {
      "id": "component.column-doing",
      "level": "component",
      "kind": "list",
      "slots": {
        "heading": ["atomic.doing-heading"],
        "items": ["component.card"]
      },
      "bindings": [],
      "actions": [],
      "states": ["loading", "empty", "ready", "error"],
      "styleIntent": {},
      "responsive": {},
      "accessibility": {
        "label": "Doing column"
      },
      "sourceRef": "enum.card-column.doing"
