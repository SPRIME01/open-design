      "id": "component.column-done",
      "level": "component",
      "kind": "list",
      "slots": {
        "heading": ["atomic.done-heading"],
        "items": ["component.card"]
      },
      "bindings": [],
      "actions": [],
      "states": ["loading", "empty", "ready", "error"],
      "styleIntent": {},
      "responsive": {},
      "accessibility": {
        "label": "Done column"
      },
      "sourceRef": "enum.card-column.done"
    },
    {
      "id": "atomic.done-heading",
      "level": "atomic",
      "kind": "heading",
      "children": [],
      "bindings": [],
      "actions": [],
      "states": [],
      "styleIntent": {
        "size": "medium"
      },
      "responsive": {},
      "accessibility": {
        "label": "Done",
        "headingLevel": 2
      },
      "sourceRef": "enum.card-column.done"
    },
    {
      "id": "component.card",
      "level": "component",
      "kind": "card",
      "slots": {
        "content": ["atomic.card-title-text"],
        "actions": ["atomic.move-card-button"]
      },
      "bindings": [
        {
          "property": "card",
          "operation": "cards.list",
          "path": "$.items[*]"
        }
      ],
      "actions": [],
      "states": ["idle", "dragging"],
      "styleIntent": {
        "surface": "raised"
      },
      "responsive": {},
      "accessibility": {
        "label": "Kanban card"
      },
      "sourceRef": "domain.card"
    },
    {
      "id": "atomic.card-title-text",
      "level": "atomic",
      "kind": "text",
      "children": [],
      "bindings": [],
      "actions": [],
      "states": [],
      "styleIntent": {},
      "responsive": {},
      "accessibility": {},
      "sourceRef": "domain.card.title"
    },
    {
      "id": "atomic.move-card-button",
      "level": "atomic",
      "kind": "button",
      "children": [],
      "bindings": [],
      "actions": [
        {
          "trigger": "activate",
          "operation": "cards.move",
          "input": {
            "id": "component.card.value.id",
            "column": "component.card.value.next-column",
            "position": "component.card.value.position"
          }
        }
      ],
      "states": ["enabled", "disabled", "pending"],
      "styleIntent": {
        "variant": "secondary"
      },
      "responsive": {},
      "accessibility": {
        "label": "Move card"
      },
      "sourceRef": "capability.cards.move"
    }
